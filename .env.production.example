# ProcureFlow production runtime template.
# Store the real file at /opt/procureflow/secrets/.env.production with mode 600.
# Never commit the populated file.
PRODUCTION_ENV_FILE=/opt/procureflow/secrets/.env.production

# Generated internal credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_GENERATED
POSTGRES_DB=procureflow_bd
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_GENERATED@postgres:5432/procureflow_bd
PGBOUNCER_URL=postgresql+asyncpg://postgres:CHANGE_ME_GENERATED@pgbouncer:6432/procureflow_bd
REDIS_PASSWORD=CHANGE_ME_GENERATED
REDIS_URL=redis://:CHANGE_ME_GENERATED@redis:6379/0
MINIO_ROOT_USER=procureflowadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_GENERATED
MINIO_ACCESS_KEY=procureflowadmin
MINIO_SECRET_KEY=CHANGE_ME_GENERATED
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=procurementflow-tenders
MINIO_SECURE=false
STORAGE_BACKEND=minio
JWT_SECRET=CHANGE_ME_GENERATED
JWT_REFRESH_SECRET=CHANGE_ME_GENERATED
SYSTEM_USER_PASSWORD=CHANGE_ME_GENERATED
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GENERATED

# Production application contract
ENVIRONMENT=production
API_WORKERS=3
ALLOWED_ORIGINS=["https://procureflowbd.com","https://www.procureflowbd.com"]
FRONTEND_URL=https://procureflowbd.com
REQUIRE_API_AUTH=true
RLS_STRICT_CONTEXT=true
MAX_UPLOAD_SIZE_MB=50
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=

# Operator-supplied external credentials; the generator leaves these empty.
OWNER_EMAIL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EGP_EMAIL=
EGP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SENTRY_DSN=
