# ProcureFlow Production Environment Template
# Copy to ignored .env and fill in real values before deploying

# Database
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@postgres:5432/procureflow_bd
PGBOUNCER_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@pgbouncer:6432/procureflow_bd
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD
POSTGRES_DB=procureflow_bd
DB_PORT=5432

# Redis
REDIS_PASSWORD=YOUR_SECURE_REDIS_PASSWORD
REDIS_URL=redis://:YOUR_SECURE_REDIS_PASSWORD@redis:6379/0

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_ROOT_USER=your-minio-admin-user
MINIO_ROOT_PASSWORD=your-strong-minio-admin-password
MINIO_BUCKET=procurementflow-tenders
STORAGE_BACKEND=minio

# JWT
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_SECRET=your-separate-refresh-secret-at-least-32-chars

# Owner account (bootstrapped on first run)
OWNER_EMAIL=admin@procureflowbd.com
OWNER_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
ENVIRONMENT=production

# CORS
ALLOWED_ORIGINS=["https://procureflowbd.com","https://www.procureflowbd.com"]
FRONTEND_URL=https://procureflowbd.com

# e-GP Portal (for document downloading)
EGP_BASE_URL=https://www.eprocure.gov.bd
EGP_EMAIL=your-egp-email@gmail.com
EGP_PASSWORD=your-egp-password

# OpenTelemetry
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-strong-grafana-password

# SOR Data
SOR_DATA_DIR=/app/sor

# Feature flags
FEATURE_AI_ANALYSIS=true
FEATURE_CRAWLER=true
FEATURE_PREDICTIONS=true
FEATURE_COMPETITOR_INTELLIGENCE=true
FEATURE_RATE_ANALYSIS=true

# Local LLM inference is intentionally disabled on the initial CPU-only VPS.
OLLAMA_ENABLED=false
